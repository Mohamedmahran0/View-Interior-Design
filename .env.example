# ============================================================
# VIEW INTERIOR DESIGN - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. Supabase (Backend & Storage)
# https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ------------------------------------------------------------
# 2. Paddle Billing (Payment Gateway)
# https://vendors.paddle.com/ (Production) or https://sandbox-vendors.paddle.com/
# ------------------------------------------------------------
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Client-side token (Vendor Settings > Developer Tools > Authentication)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_client_token_here
# Server-side API key (Vendor Settings > Developer Tools > Authentication)
PADDLE_API_KEY=test_api_key_here
# Webhook secret key (Notifications > Webhooks)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_01...

# Paddle Price IDs (Catalog > Products / Prices)
NEXT_PUBLIC_PADDLE_PRICE_BASIC_MONTHLY=pri_01...
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=pri_02...
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_MONTHLY=pri_03...

# ------------------------------------------------------------
# 3. Application & Deployment URL
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://viewinteriordesign.com
